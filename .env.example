# CTF-Agent runtime settings
CTF_PORT=4399
TZ=Asia/Shanghai

# Published image generated by GitHub Actions
CTF_AGENT_IMAGE=ghcr.io/conly-zy/ctf-agent
CTF_AGENT_IMAGE_TAG=latest

# LLM provider: anthropic or openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-7
LLM_BASE_URL=

# Prefer provider-specific API keys. Keep this file private after copying to .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
